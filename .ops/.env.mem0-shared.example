# Canonical start command from repo root:
# docker compose --env-file .ops/mem0-phase2/.env -f .ops/mem0-phase2/docker-compose.mem0-shared.yml up -d

# Shared Docker network (same concept as Langfuse shared services)
SHARED_DOCKER_NETWORK=shared_service_network

# Shared service DNS/port checks used by shared-services-ready
SHARED_POSTGRES_HOST=postgres_share
SHARED_POSTGRES_PORT=5432
SHARED_QDRANT_HOST=qdrant
SHARED_QDRANT_PORT=6333

# API and UI exposure
MEM0_API_HOST_IP=0.0.0.0
MEM0_API_HOST_PORT=9100
MEM0_UI_HOST_IP=0.0.0.0
MEM0_UI_HOST_PORT=9101
NEXT_PUBLIC_API_URL=http://localhost:9100

# Default user created by OpenMemory API at startup
MEM0_USER_ID=shared_mem0_user

# Runtime DB/vector configuration (container-to-container over shared network)
DATABASE_URL=postgresql://admin:admin@postgres_share:5432/mem0_openmemory
QDRANT_HOST=qdrant
QDRANT_PORT=6333

# NVIDIA DIM (OpenAI-compatible) for LLM + embeddings
NVIDIA_API_KEY=replace-with-nvidia-dim-key
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# OpenMemory runtime currently expects these OpenAI-compatible envs.
# Keep them pointed at NVIDIA for this test setup.
OPENAI_API_KEY=replace-with-nvidia-dim-key
OPENAI_BASE_URL=https://integrate.api.nvidia.com/v1

LLM_PROVIDER=openai
LLM_MODEL=meta/llama-3.3-70b-instruct
LLM_API_KEY=env:NVIDIA_API_KEY
LLM_BASE_URL=https://integrate.api.nvidia.com/v1

EMBEDDER_PROVIDER=openai
EMBEDDER_MODEL=nvidia/nv-embed-v1
EMBEDDER_API_KEY=env:NVIDIA_API_KEY
EMBEDDER_BASE_URL=https://integrate.api.nvidia.com/v1

# Container safety controls
MEM0_API_CPUS=2.0
MEM0_API_MEM_LIMIT=2g
MEM0_UI_CPUS=1.0
MEM0_UI_MEM_LIMIT=1g
